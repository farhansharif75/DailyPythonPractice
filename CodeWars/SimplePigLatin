# Move the first letter of each word to the end of it, then add "ay" to the end of the word. Leave punctuation marks untouched.

import string
def pig_it(text):
    words = text.split(' ')
    shifted_words = [word[1:]+word[0] for word in words]
    pig_latinised = [word + "ay" if (word not in string.punctuation) else word for word in shifted_words]
    return ' '.join(pig_latinised)
