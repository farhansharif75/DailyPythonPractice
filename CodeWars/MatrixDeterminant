# Write a function that accepts a square matrix (N x N 2D array) and returns the determinant of the matrix.
# Tried to do from scratch for practice

def get_minor(i, j, matrix):
    return [row[:j] + row[j+1:] for row in (matrix[:i] + matrix[i+1:])] # crucial slicing logic

def determinant(matrix):
    if len(matrix) != len(matrix[0]):
        raise ValueError("Expected a square n x n matrix as input")
    
    # Special case 1: det of 1 x 1 matrix is just the number in it
    if (len(matrix), len(matrix[0])) == (1, 1):
        return matrix[0][0]
        
    # More general case involves reducing the matrix recursively and aggregating the determinant
    det = 0
    # iterate over the *columns*
    for c in range(len(matrix[0])):
        det += (-1) ** c * matrix[0][c] * determinant(get_minor(0, c, matrix)) # crucial recursion logic
        
    return det
